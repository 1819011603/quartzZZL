        "responses": {
          "200": {
            "description": "实测返回",
            "content": {
              "application/json": {
                "example": {
                  "code": 0,
                  "data": {
                    "total": 1,
                    "pageNum": 1,
                    "pageSize": 20,
                    "list": [
                      {
                        "couponName": "暑期膨胀券50抵200",
                        "couponId": 10086,
                        "couponSkuNumber": 801400001,
                        "productType": 8014,
                        "buyAmount": 5000,
                        "deductibleAmount": 20000,
                        "soldCount": 12,
                        "totalCount": 1000,
                        "creator": null,
                        "couponStatus": 1,
                        "couponStatusDesc": "使用中",
                        "selectable": true
                      }
                    ]
                  },
                  "msg": ""
                }
              }
            }
          }
        }
      }
    },
