    "/bgwApi/product-b/b/renewal/preOrderActivity/couponScope/list": {
      "post": {
        "tags": [
          "2-券配置回显(product-server)"
        ],
        "summary": "膨胀券活动的券配置与适用范围（活动详情抽屉回显）",
        "description": "⚠️ **实测：接口通(code:0) 但 `scopes` 为空**，这是已知问题不是新 bug，两个原因叠加：\n1. scope 表造数挂在**假活动号** 9001/9002/9003，与真实活动 578363764011708416 对不上\n2. promotion `pre_order_activity_product` 表无券列，缓存重建后券字段为 null\n\n要看到非空 scopes，需先把 scope 数据的 activity_number 改成真实活动号。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "preOrderActivityNumber"
                ],
                "properties": {
                  "preOrderActivityNumber": {
                    "type": "integer",
                    "format": "int64",
                    "description": "预报名活动编号"
                  }
                }
              },
              "example": {
                "preOrderActivityNumber": 578363764011708416
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "实测返回（scopes 为空，见上）",
            "content": {
              "application/json": {
                "example": {
                  "code": 0,
                  "data": [
                    {
                      "deductible_amount": 20000,
                      "product_number": "801400001",
                      "scopes": []
                    },
                    {
                      "deductible_amount": 40000,
                      "product_number": "801400002",
                      "scopes": []
                    }
                  ],
                  "msg": "success！"
                }
              }
            }
          }
        }
      }
    },
