+    private void handleEs(HttpExchange exchange) throws IOException {
+        String path = exchange.getRequestURI().getPath();
+        String method = exchange.getRequestMethod();
+        requests.add(method + " " + path);
+        String body = StreamUtils.copyToString(exchange.getRequestBody(), StandardCharsets.UTF_8);
+        String response;
+        int status = 200;
+        if ("DELETE".equals(method)) {
+            response = "{\"succeeded\":true,\"num_freed\":1}";
+        } else if (path.endsWith("/_bulk")) {
+            writes.add(body);
+            List<Map<String, Object>> items = new ArrayList<>();
+            String[] lines = body.split("\n");
+            for (int i = 0; i < lines.length; i += 2) {
+                Map<String, Object> action = (Map<String, Object>) json.readValue(lines[i], Map.class).get("update");
+                Map<String, Object> item = new HashMap<>();
+                item.put("_index", action.get("_index"));
+                item.put("_type", "_doc");
+                item.put("_id", action.get("_id"));
+                item.put("status", conflict ? 409 : 200);
+                if (conflict) {
+                    Map<String, String> error = new HashMap<>();
+                    error.put("type", "version_conflict_engine_exception");
+                    error.put("reason", "concurrent edit");
+                    item.put("error", error);
+                } else {
+                    item.put("_version", 2);
+                    item.put("result", "updated");
+                    item.put("_seq_no", 8);
+                    item.put("_primary_term", 1);
+                    item.put("_shards", shardInfo());
+                }
+                items.add(Collections.singletonMap("update", item));
+            }
+            response = "{\"took\":1,\"errors\":" + conflict + ",\"items\":" + json.writeValueAsString(items) + "}";
+        } else {
+            if (path.endsWith("/_search")) {
+                Map<String, Object> search = json.readValue(body, Map.class);
+                pageSize = ((Number) search.get("size")).intValue();
+                Map<String, Object> query = (Map<String, Object>) search.get("query");
+                Map<String, Object> terms = (Map<String, Object>) query.get("terms");
+                List<?> clazzNumbers = terms == null ? null : (List<?>) terms.get("clazzNumber");
+                selected = documents.stream().filter(hit -> clazzNumbers == null || clazzNumbers.stream().anyMatch(
+                        number -> ((Number) number).longValue() == ((Number) ((Map<?, ?>) hit.get("_source")).get("clazzNumber")).longValue()))
+                        .collect(Collectors.toList());
+                offset = 0;
+            }
+            if (failScroll && path.endsWith("/_search/scroll")) {
+                status = 400;
+                response = "{\"error\":{\"type\":\"search_context_missing_exception\",\"reason\":\"expired\"},\"status\":400}";
+            } else {
+                int end = Math.min(offset + pageSize, selected.size());
+                List<Map<String, Object>> page = selected.subList(offset, end);
+                offset = end;
+                response = "{\"_scroll_id\":\"cursor\",\"took\":1,\"timed_out\":" + timedOut
+                        + ",\"_shards\":" + json.writeValueAsString(shardInfo())
+                        + ",\"hits\":{\"total\":{\"value\":" + selected.size() + ",\"relation\":\"eq\"},"
+                        + "\"max_score\":1,\"hits\":" + json.writeValueAsString(page) + "}}";
+            }
+        }
+        byte[] bytes = response.getBytes(StandardCharsets.UTF_8);
+        exchange.getResponseHeaders().set("Content-Type", "application/json");
+        exchange.sendResponseHeaders(status, bytes.length);
+        exchange.getResponseBody().write(bytes);
+        exchange.close();
+    }
+
+    private Map<String, Integer> shardInfo() {
+        Map<String, Integer> shards = new HashMap<>();
+        shards.put("total", 1);
+        shards.put("successful", 1);
+        shards.put("failed", 0);
+        return shards;
+    }
+}
