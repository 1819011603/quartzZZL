+-- 发布前导出以下结果，核对重复、已删除、降级和已有映射配置。
+-- 2026-11-04 生产快照：小班三条已存在，大班零条，预期新增大班三条。
+SELECT id, identification, field_name, `type`, command, is_del
+FROM ees_data.es_query_config
+WHERE identification IN ('continuationService', 'microContinuationService')
+  AND field_name IN ('studentTags', 'studentTagNames')
+ORDER BY identification, field_name, `type`, command;
+
+-- 精确配置已存在时不重复插入。存在 is_del=1 时也不重复插入，先人工核对。
+INSERT INTO ees_data.es_query_config (identification, field_name, `type`, command, is_del)
+SELECT scenes.identification, fields.field_name, fields.config_type, fields.command, 0
+FROM (
+  SELECT 'continuationService' AS identification
+  UNION ALL SELECT 'microContinuationService'
+) scenes
+CROSS JOIN (
+  SELECT 'studentTags' AS field_name, 2 AS config_type, 'basic' AS command
+  UNION ALL SELECT 'studentTags', 6, 'necessary'
+  UNION ALL SELECT 'studentTagNames', 6, 'extra'
+) fields
+WHERE NOT EXISTS (
+  SELECT 1 FROM ees_data.es_query_config existing
+  WHERE existing.identification = scenes.identification
+    AND existing.field_name = fields.field_name
+    AND existing.`type` = fields.config_type
+    AND existing.command = fields.command
+);
+
+-- 执行后保存新增 ID。回滚只删除这些 ID，不按字段整批删，也不依赖 is_del。
+SELECT id, identification, field_name, `type`, command, is_del
+FROM ees_data.es_query_config
+WHERE identification IN ('continuationService', 'microContinuationService')
+  AND field_name IN ('studentTags', 'studentTagNames')
+ORDER BY identification, field_name, `type`, command;
