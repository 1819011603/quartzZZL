@@ -0,0 +1,247 @@
+package com.gaotu.yunying.student.center.domain.service.roster;
+
+import java.io.IOException;
+import java.time.LocalDate;
+import java.time.ZoneId;
+import java.time.format.DateTimeParseException;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.stream.Collectors;
+
+import javax.annotation.Resource;
+
+import org.apache.commons.collections4.CollectionUtils;
+import org.apache.commons.collections4.MapUtils;
+import org.apache.commons.lang3.StringUtils;
+import org.elasticsearch.action.bulk.BulkRequest;
+import org.elasticsearch.action.bulk.BulkResponse;
+import org.elasticsearch.action.search.ClearScrollRequest;
+import org.elasticsearch.action.search.SearchRequest;
+import org.elasticsearch.action.search.SearchResponse;
+import org.elasticsearch.action.search.SearchScrollRequest;
+import org.elasticsearch.action.support.WriteRequest;
+import org.elasticsearch.action.update.UpdateRequest;
+import org.elasticsearch.client.RequestOptions;
+import org.elasticsearch.client.RestHighLevelClient;
+import org.elasticsearch.common.unit.TimeValue;
+import org.elasticsearch.index.query.QueryBuilders;
+import org.elasticsearch.search.SearchHit;
+import org.elasticsearch.search.builder.SearchSourceBuilder;
+import org.springframework.stereotype.Service;
+
+import com.gaotu.student.data.client.acl.ClazzSyncAclService;
+import com.gaotu.student.data.client.acl.model.ClazzDO;
+import com.gaotu.yunying.student.center.constant.ScenePageCodeConstant;
+import com.gaotu.yunying.student.center.domain.model.roster.RenewalStudentTagsRecallRequest;
+import com.gaotu.yunying.student.center.domain.util.EsIndexUtil;
+import com.gaotu.yunying.student.center.domain.util.GaiaPageSceneUtil;
+import com.gaotu.yunying.student.center.infrastructure.dao.entity.UserClazzMarkInfo;
+import com.gaotu.yunying.student.center.infrastructure.dao.service.UserClazzMarkInfoDao;
+import com.gaotu.yunying.student.center.infrastructure.exception.BusinessErrorCode;
+import com.gaotu.yunying.student.center.infrastructure.exception.BusinessException;
+import com.gaotu.yunying.student.center.infrastructure.util.Tuple;
+
+import lombok.Data;
+import lombok.extern.slf4j.Slf4j;
+
+/**
+ * 从当前业务标签表回填续班索引，只更新已有文档的标签。
+ *
+ * @author masheng
+ * @date 2026/11/04 15:00
+ */
+@Slf4j
+@Service
+public class RenewalStudentTagsRecallService {
+
+    private static final String LARGE_INDEX = "ads_large_subclazz_user_index";
+    private static final TimeValue SCROLL_KEEP_ALIVE = TimeValue.timeValueMinutes(5);
+    private static final ZoneId BUSINESS_ZONE = ZoneId.of("Asia/Shanghai");
+
+    @Resource
+    private RestHighLevelClient studentSubclazzClient;
+    @Resource
+    private RestHighLevelClient studentServeClient;
+    @Resource
+    private ClazzSyncAclService clazzSyncAclService;
+    @Resource
+    private UserClazzMarkInfoDao userClazzMarkInfoDao;
+
+    /**
+     * 按班级创建日期回填标签，参数省略 dryRun 时仅预演。
+     *
+     * @param request 回溯场景、日期范围和执行参数
+     * @return 扫描、跳过、待更新及已更新记录数
+     * @throws IOException ES 请求失败或批量写入部分失败
+     * @throws InterruptedException 任务被中断
+     */
+    public RecallResult recall(RenewalStudentTagsRecallRequest request) throws IOException, InterruptedException {
+        long[] range = validate(request);
+        boolean large = ScenePageCodeConstant.RENEWAL_SERVICE.equals(request.getScene());
+        RestHighLevelClient client = large ? studentSubclazzClient : studentServeClient;
+        String index = large ? LARGE_INDEX : EsIndexUtil.SMALL_CLAZZ_USER_INDEX;
+        SearchSourceBuilder source = new SearchSourceBuilder().size(request.getBatchSize()).sort("_doc")
+                .seqNoAndPrimaryTerm(true).fetchSource(new String[]{"clazzNumber", "userId", "studentTags"}, null);
+        source.query(CollectionUtils.isEmpty(request.getClazzNumbers()) ? QueryBuilders.matchAllQuery()
+                : QueryBuilders.termsQuery("clazzNumber", request.getClazzNumbers()));
+        SearchRequest search = new SearchRequest(index).source(source).scroll(SCROLL_KEEP_ALIVE);
+        RecallResult result = new RecallResult();
+        String scrollId = null;
+        try {
+            SearchResponse response = client.search(search, RequestOptions.DEFAULT);
+            while (true) {
+                scrollId = response.getScrollId();
+                // ES 可能返回部分分片结果；不能将其当作完整回溯成功。
+                if (response.isTimedOut() || response.getFailedShards() > 0) {
+                    throw new IOException("标签回溯查询超时或存在失败分片");
+                }
+                SearchHit[] hits = response.getHits().getHits();
+                if (hits.length == 0) {
+                    return result;
+                }
+                if (StringUtils.isBlank(scrollId)) {
+                    throw new IOException("标签回溯查询未返回滚动游标");
+                }
+                if (Thread.currentThread().isInterrupted()) {
+                    throw new InterruptedException("标签回溯任务已中断");
+                }
+                recallBatch(client, hits, request, range, result);
+                log.info("续班标签回溯进度，scene={}，dryRun={}，result={}", request.getScene(), request.getDryRun(), result);
+                if (request.getIntervalMillis() > 0) {
+                    Thread.sleep(request.getIntervalMillis());
+                }
+                response = client.scroll(new SearchScrollRequest(scrollId).scroll(SCROLL_KEEP_ALIVE), RequestOptions.DEFAULT);
+            }
+        } finally {
+            if (StringUtils.isNotBlank(scrollId)) {
+                try {
+                    ClearScrollRequest clear = new ClearScrollRequest();
+                    clear.addScrollId(scrollId);
+                    client.clearScroll(clear, RequestOptions.DEFAULT);
+                } catch (Exception e) {
+                    log.warn("续班标签回溯游标清理失败，scene={}", request.getScene(), e);
+                }
+            }
+        }
+    }
+
+    private void recallBatch(RestHighLevelClient client, SearchHit[] hits, RenewalStudentTagsRecallRequest request,
+            long[] range, RecallResult result) throws IOException {
+        List<Long> clazzNumbers = Arrays.stream(hits).map(hit -> MapUtils.getLong(hit.getSourceAsMap(), "clazzNumber"))
+                .filter(Objects::nonNull).distinct().collect(Collectors.toList());
+        Map<Long, ClazzDO> clazzMap = clazzNumbers.isEmpty() ? Collections.emptyMap()
+                : clazzSyncAclService.listByNumbersFromCache(clazzNumbers).stream()
+                        .collect(Collectors.toMap(ClazzDO::getNumber, clazz -> clazz, (first, second) -> first));
+        Map<Tuple<Long, Long>, UserClazzMarkInfo> pairs = new HashMap<>();
+        for (SearchHit hit : hits) {
+            result.scanned++;
+            Long clazzNumber = MapUtils.getLong(hit.getSourceAsMap(), "clazzNumber");
+            Long userId = MapUtils.getLong(hit.getSourceAsMap(), "userId");
+            if (clazzNumber == null || userId == null || clazzNumber <= 0 || userId <= 0) {
+                throw new IOException("标签回溯记录缺少有效班级或学员编号，id=" + hit.getId());
+            }
+            ClazzDO clazz = clazzMap.get(clazzNumber);
+            if (clazz == null || clazz.getCreateTime() == null) {
+                throw new IOException("标签回溯未查到班级创建时间，clazzNumber=" + clazzNumber);
+            }
+            if (clazz.getCreateTime() < range[0] || clazz.getCreateTime() >= range[1]) {
+                result.outOfRange++;
+                continue;
+            }
+            UserClazzMarkInfo pair = new UserClazzMarkInfo();
+            pair.setClazzNumber(clazzNumber);
+            pair.setUserId(userId);
+            pairs.put(Tuple.of(userId, clazzNumber), pair);
+        }
+        if (pairs.isEmpty()) {
+            return;
+        }
+        Map<Tuple<Long, Long>, UserClazzMarkInfo> marks = userClazzMarkInfoDao
+                .listByUserClazzPairs(new ArrayList<>(pairs.values())).stream()
+                .collect(Collectors.toMap(mark -> Tuple.of(mark.getUserId(), mark.getClazzNumber()), mark -> mark));
+        BulkRequest bulk = new BulkRequest().setRefreshPolicy(WriteRequest.RefreshPolicy.NONE);
+        for (SearchHit hit : hits) {
+            Tuple<Long, Long> key = Tuple.of(MapUtils.getLong(hit.getSourceAsMap(), "userId"),
+                    MapUtils.getLong(hit.getSourceAsMap(), "clazzNumber"));
+            if (!pairs.containsKey(key)) {
+                continue;
+            }
+            UserClazzMarkInfo mark = marks.get(key);
+            if (mark == null || mark.getTags() == null) {
+                result.missingSource++;
+                continue;
+            }
+            List<Integer> tags = Arrays.stream(mark.getTags().split(",")).map(String::trim)
+                    .filter(StringUtils::isNotBlank).map(Integer::valueOf).distinct().collect(Collectors.toList());
+            if (tags.equals(hit.getSourceAsMap().get("studentTags"))) {
+                result.unchanged++;
+                continue;
+            }
+            if (hit.getSeqNo() < 0 || hit.getPrimaryTerm() <= 0) {
+                throw new IOException("标签回溯记录缺少并发版本，id=" + hit.getId());
+            }
+            // 使用扫描时的物理索引、版本，只更新存量记录，避免覆盖并发编辑或重建残缺文档。
+            bulk.add(new UpdateRequest(hit.getIndex(), hit.getId())
+                    .setIfSeqNo(hit.getSeqNo()).setIfPrimaryTerm(hit.getPrimaryTerm())
+                    .doc(Collections.singletonMap("studentTags", tags)));
+            result.planned++;
+        }
+        if (!request.getDryRun() && bulk.numberOfActions() > 0) {
+            BulkResponse response = client.bulk(bulk, RequestOptions.DEFAULT);
+            if (response.hasFailures()) {
+                throw new IOException("标签回溯批量写入失败，排查后重跑：" + response.buildFailureMessage());
+            }
+            result.updated += bulk.numberOfActions();
+        }
+    }
+
+    private long[] validate(RenewalStudentTagsRecallRequest request) {
+        if (request == null || !(ScenePageCodeConstant.RENEWAL_SERVICE.equals(request.getScene())
+                || GaiaPageSceneUtil.MICRO_RENEWAL_SERVICE.equals(request.getScene()))) {
+            throw BusinessException.withMsg(BusinessErrorCode.PARAM_ERROR, "仅支持大小班续班场景");
+        }
+        if (request.getDryRun() == null || request.getBatchSize() == null || request.getBatchSize() < 1
+                || request.getBatchSize() > 500 || request.getIntervalMillis() == null
+                || request.getIntervalMillis() < 0 || request.getIntervalMillis() > 2000
+                || (request.getClazzNumbers() != null && (request.getClazzNumbers().isEmpty()
+                || request.getClazzNumbers().size() > 500
+                || request.getClazzNumbers().stream().anyMatch(number -> number == null || number <= 0)))) {
+            throw BusinessException.withMsg(BusinessErrorCode.PARAM_ERROR, "批次、间隔、预演标志或班级列表不合法");
+        }
+        if (StringUtils.isBlank(request.getBeginDate()) || StringUtils.isBlank(request.getEndDate())) {
+            throw BusinessException.withMsg(BusinessErrorCode.PARAM_ERROR, "必须提供班级创建日期范围");
+        }
+        try {
+            LocalDate begin = LocalDate.parse(request.getBeginDate());
+            LocalDate end = LocalDate.parse(request.getEndDate());
+            if (begin.isBefore(LocalDate.of(2026, 1, 1)) || !begin.isBefore(end)) {
+                throw BusinessException.withMsg(BusinessErrorCode.PARAM_ERROR, "日期下界不得早于 2026-01-01，且必须小于上界");
+            }
+            return new long[]{begin.atStartOfDay(BUSINESS_ZONE).toInstant().toEpochMilli(),
+                    end.atStartOfDay(BUSINESS_ZONE).toInstant().toEpochMilli()};
+        } catch (DateTimeParseException e) {
+            throw new BusinessException(BusinessErrorCode.PARAM_ERROR, e);
+        }
+    }
+
+    /**
+     * 回溯统计均以 ES 文档条数计数，同一班级学员可对应多条辅导班记录。
+     *
+     * @author masheng
+     * @date 2026/11/04 15:00
+     */
+    @Data
+    public static class RecallResult {
+        private long scanned;
+        private long outOfRange;
+        private long missingSource;
+        private long unchanged;
+        private long planned;
+        private long updated;
+    }
+}
