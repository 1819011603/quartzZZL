+/**
+ * 续班业务标签手动回溯入口，默认预演。
+ *
+ * @author masheng
+ * @date 2026/11/04 15:00
+ */
+@Slf4j
+@Component
+@Profile({"test", "beta", "prod"})
+@JobHandler("recallRenewalStudentTagsHandler")
+public class RecallRenewalStudentTagsHandler extends IJobHandler {
+
+    @Resource
+    private ObjectMapper objectMapper;
+    @Resource
+    private RenewalStudentTagsRecallService renewalStudentTagsRecallService;
+
+    /**
+     * 执行手动回溯，参数或数据异常时返回失败。
+     *
+     * @param param JSON 格式回溯参数
+     * @return 执行结果及统计信息
+     */
+    @Override
+    public ReturnT<String> execute(String param) {
+        try {
+            RenewalStudentTagsRecallRequest request = objectMapper.readValue(param, RenewalStudentTagsRecallRequest.class);
+            RenewalStudentTagsRecallService.RecallResult result = renewalStudentTagsRecallService.recall(request);
+            XxlJobLogger.log("续班标签回溯完成，scene={}，dryRun={}，result={}", request.getScene(), request.getDryRun(), result);
+            return new ReturnT<>(ReturnT.SUCCESS_CODE, result.toString());
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+            XxlJobLogger.log("续班标签回溯已中断");
+            return ReturnT.FAIL;
+        } catch (Exception e) {
+            log.error("续班标签回溯失败", e);
+            XxlJobLogger.log("续班标签回溯失败：{}", e.getMessage());
+            return ReturnT.FAIL;
+        }
+    }
+}
