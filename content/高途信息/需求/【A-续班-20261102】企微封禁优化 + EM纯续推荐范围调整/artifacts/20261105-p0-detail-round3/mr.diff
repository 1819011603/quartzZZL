+    @ApiModelProperty("班级创建日期上界，不包含，必填，格式 yyyy-MM-dd")
+    private String endDate;
+
+    @ApiModelProperty("限定课程班级编号，不填时扫描该场景全部已有记录")
+    private List<Long> clazzNumbers;
+
+    @ApiModelProperty("预演时只统计，不写入 ES，默认 true")
+    private Boolean dryRun = true;
+
+    @ApiModelProperty("每批扫描记录数，范围 1 至 500")
+    private Integer batchSize = 200;
+
+    @ApiModelProperty("批次间隔毫秒数，范围 0 至 2000")
+    private Integer intervalMillis = 100;
+}
