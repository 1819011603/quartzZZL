-            return new ArrayList<>();
-        }
-        return result;
-    }
-
-    private List<Long> distinct(Collection<Long> numbers) {
-        return numbers.stream().filter(Objects::nonNull).distinct().collect(Collectors.toList());
-    }
-
-    private String cacheKey(String kind, Long userId, List<Long> numbers) {
-        List<Long> sorted = new ArrayList<>(numbers);
-        Collections.sort(sorted);
-        String hash = DigestUtils.md5DigestAsHex(StringUtils.join(sorted, ",").getBytes(StandardCharsets.UTF_8));
-        return CACHE_PREFIX + userId + ":" + kind + ":" + hash;
-    }
-
-    private <T> List<T> getCache(String key, Class<T> clazz) {
-        try {
-            String value = redisTemplate.opsForValue().get(key);
-            log.info("renewal cross-mode order cache read, key={}, hit={}, empty={}", key, value != null, EMPTY_SENTINEL.equals(value));
-            if (value == null) {
-                return null;
-            }
-            if (EMPTY_SENTINEL.equals(value)) {
-                return new ArrayList<>();
-            }
-            return JSON.parseArray(value, clazz);
-        } catch (Exception e) {
-            log.warn("renewal cross-mode order cache get failed, key={}", key, e);
-            return null;
-        }
-    }
-
-    private void putCache(String key, List<?> list) {
-        try {
-            log.info("renewal cross-mode order cache set, key={}, empty={}", key, CollectionUtils.isEmpty(list));
-            if (CollectionUtils.isEmpty(list)) {
-                redisTemplate.opsForValue().set(key, EMPTY_SENTINEL, cacheEmptyExpireSeconds, TimeUnit.SECONDS);
-            } else {
-                redisTemplate.opsForValue().set(key, JSON.toJSONString(list), cacheExpireSeconds, TimeUnit.SECONDS);
-            }
-        } catch (Exception e) {
-            log.warn("renewal cross-mode order cache set failed, key={}", key, e);
-        }
-    }
-}
