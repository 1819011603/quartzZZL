-    private List<OrderInfoDTO> listOrderItemOrdersAsOrderInfo(Collection<Long> preCourseNumbers, Long userId) {
-        if (!pureRelationEnabled || userId == null || CollectionUtils.isEmpty(preCourseNumbers)) {
-            return new ArrayList<>();
-        }
-        List<Long> numbers = distinct(preCourseNumbers);
-        String key = cacheKey("i2i", userId, numbers);
-        if (orderCacheEnabled) {
-            List<OrderInfoDTO> cached = getCache(key, OrderInfoDTO.class);
-            if (cached != null) {
-                return cached;
-            }
-        }
-        List<OrderInfoDTO> result = new ArrayList<>();
-        try {
-            List<OrderItemDTO> items = orderInfoAdapterFeignService.listBySpuNumbersAndUserIdAndStatus(numbers, userId);
-            if (CollectionUtils.isNotEmpty(items)) {
-                for (OrderItemDTO it : items) {
-                    if (it == null || it.getSpuNumber() == null) {
-                        continue;
-                    }
-                    OrderInfoDTO dto = new OrderInfoDTO();
-                    dto.setCourseNumber(it.getSpuNumber());
-                    dto.setClazzNumber(it.getSkuNumber());
-                    dto.setUserId(userId);
-                    dto.setOrderStatus(it.getOrderStatus());
-                    // coreHandle 以 orderNumber 非空判有效订单，这里用订单项号兜底
-                    dto.setOrderNumber(it.getNumber());
-                    result.add(dto);
-                }
-            }
-            if (orderCacheEnabled) {
-                putCache(key, result);
-            }
-        } catch (Exception e) {
-            log.warn("renewal cross-mode order bypass(item->info) failed, userId={}", userId, e);
-            return new ArrayList<>();
-        }
-        return result;
-    }
