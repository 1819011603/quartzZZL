-        }
-        List<Long> numbers = distinct(preCourseNumbers);
-        String key = cacheKey("i2o", userId, numbers);
-        if (orderCacheEnabled) {
-            List<OrderItemDTO> cached = getCache(key, OrderItemDTO.class);
-            if (cached != null) {
-                return cached;
-            }
-        }
-        List<OrderItemDTO> result = new ArrayList<>();
-        try {
-            List<OrderInfoDTO> orders = orderInfoAdapterFeignService.listByCourseNumbersAndUserIdAndStatus(numbers, userId);
-            if (CollectionUtils.isNotEmpty(orders)) {
-                for (OrderInfoDTO o : orders) {
-                    if (o == null || o.getCourseNumber() == null) {
-                        continue;
-                    }
-                    OrderItemDTO dto = new OrderItemDTO();
-                    dto.setSpuNumber(o.getCourseNumber());
-                    dto.setSkuNumber(o.getClazzNumber());
-                    dto.setUserId(userId);
-                    dto.setOrderStatus(o.getOrderStatus());
-                    dto.setNumber(o.getOrderNumber());
-                    result.add(dto);
-                }
-            }
-            if (orderCacheEnabled) {
-                putCache(key, result);
-            }
-        } catch (Exception e) {
