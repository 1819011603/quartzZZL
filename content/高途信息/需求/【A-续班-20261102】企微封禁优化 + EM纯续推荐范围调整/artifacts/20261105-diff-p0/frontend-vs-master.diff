+++ b/src/pages/continuationClasses/components/PureRenewRelation/index.js
@@ -0,0 +1,380 @@
+import {memo, useState} from 'react';
+import PropTypes from 'prop-types';
+import {Access, FeituData, QueryFilter, ProFormSelect, ProFormText, FeituTable} from 'feitud5';
+import {Drawer, Button, Tag, Modal, message, Tooltip} from 'antd';
+import {useMemoizedFn, useRequest} from 'ahooks';
+import {getPureRenewRelations, savePureRenewRelations} from '@/services/continuationClasses';
+import {statusMap, statusOptions, renewalPlanStatusEnum} from '../../config';
+import {getEllipsisTooltip} from '../../detail/Relations/utils';
+import listStyles from '../../list/index.less';
+import styles from './index.less';
+
+// 可操作纯续关联的续班计划状态：入口按钮可点、搜索结果范围均以此为准
+const OPERABLE_STATUS = [renewalPlanStatusEnum.WAIT_START, renewalPlanStatusEnum.IN_PROGRESS];
+const OPERABLE_STATUS_OPTIONS = statusOptions.filter(({value}) => OPERABLE_STATUS.includes(+value));
+const OPERABLE_STATUS_VALUES = OPERABLE_STATUS_OPTIONS.map(({value}) => value);
+const IS_TEST_DATA_OPTIONS = [{label: '是', value: 1}, {label: '否', value: 0}];
+
+const planPropType = PropTypes.shape({
+    number: PropTypes.oneOfType([PropTypes.string, PropTypes.number]),
+    name: PropTypes.string,
+    status: PropTypes.oneOfType([PropTypes.string, PropTypes.number]),
+    adminName: PropTypes.string,
+    adminList: PropTypes.arrayOf(
+        PropTypes.shape({
+            id: PropTypes.oneOfType([PropTypes.string, PropTypes.number]),
+            name: PropTypes.string,
+        }),
+    ),
+});
+
+const adminNames = list => (Array.isArray(list) ? list.map(i => i.name).join('，') : '--');
+const adminName = item => item?.adminName || adminNames(item?.adminList) || '--';
+
+// 状态标签样式与列表页保持一致
+const STATUS_CLASS = {
+    [renewalPlanStatusEnum.WAIT_PUBLISH]: listStyles.statusTagDraft,
+    [renewalPlanStatusEnum.WAIT_START]: listStyles.statusTagPending,
+    [renewalPlanStatusEnum.IN_PROGRESS]: listStyles.statusTagActive,
+    [renewalPlanStatusEnum.FINISHED]: listStyles.statusTagFinished,
+};
+
+function StatusTag({status}) {
+    return (
+        <span className={STATUS_CLASS[status] || listStyles.statusTag}>
+            {statusMap[status] || '--'}
+        </span>
+    );
+}
+
+StatusTag.propTypes = {
+    status: PropTypes.oneOfType([PropTypes.string, PropTypes.number]),
+};
+
+StatusTag.defaultProps = {
+    status: null,
+};
+
+// 名称、管理员超长省略，hover 展示全文（与列表页一致）
+const columns = [
+    {title: '状态', dataIndex: 'status', width: 90, render: s => <StatusTag status={s} />},
+    {title: '续班计划名称', dataIndex: 'name', render: getEllipsisTooltip},
+    {title: '续班计划ID', dataIndex: 'number', width: 180},
+    {
+        title: '管理员',
+        dataIndex: 'adminName',
+        width: 120,
+        render: (_, item) => getEllipsisTooltip(adminName(item)),
+    },
+];
+
+// 计划信息：首行状态 + 名称，次行 ID / 管理员
+function PlanInfo({item}) {
+    return (
+        <>
+            <div className={styles.planName}>
+                <StatusTag status={item?.status} />
+                <span className={styles.planNameText} title={item?.name}>
+                    {item?.name || '--'}
+                </span>
+            </div>
+            <div className={styles.planMeta}>
+                <span>
+                    {`ID：${item?.number || '--'}`}
+                </span>
+                <span>
+                    {`管理员：${adminName(item)}`}
+                </span>
+            </div>
+        </>
+    );
+}
+
+PlanInfo.propTypes = {
+    item: planPropType,
+};
+
+PlanInfo.defaultProps = {
+    item: {},
+};
+
+// Tooltip 深色底，不放状态色块，纯文本展示
+function PlanInfoText({item}) {
+    return (
+        <div className={styles.planTooltip}>
+            <div>
+                {`状态：${statusMap[item?.status] || '--'}`}
+            </div>
+            <div>
+                {`名称：${item?.name || '--'}`}
+            </div>
+            <div>
+                {`ID：${item?.number || '--'}`}
+            </div>
+            <div>
+                {`管理员：${adminName(item)}`}
+            </div>
+        </div>
+    );
+}
+
+PlanInfoText.propTypes = {
+    item: planPropType,
+};
+
+PlanInfoText.defaultProps = {
+    item: {},
+};
+
+function SelectedTag({item, onRemove}) {
+    const handleClose = useMemoizedFn(() => onRemove(item.number));
+    return (
+        <Tooltip title={<PlanInfoText item={item} />} overlayClassName={styles.tagTooltip}>
+            {/* antd Tag needs className for the selected-tag layout; the project rule otherwise forbids it. */}
+            {/* eslint-disable-next-line react/forbid-component-props */}
+            <Tag closable onClose={handleClose} className={styles.selectedTag}>
+                <span className={styles.tagStatus}>
+                    <StatusTag status={item.status} />
+                </span>
+                <span className={styles.tagName}>
+                    {item.name}
+                </span>
+            </Tag>
+        </Tooltip>
+    );
+}
+
+SelectedTag.propTypes = {
+    item: planPropType.isRequired,
+    onRemove: PropTypes.func.isRequired,
+};
+
+/**
+ * 纯续关联入口 + 抽屉
+ * @param {Object} props
+ * @param {Object} props.record - 当前续班计划行数据
+ * @param {boolean} props.isAdmin - 当前用户是否为该续班计划管理员
+ */
+function PureRenewRelation({record, isAdmin}) {
+    const [open, setOpen] = useState(false);
+    const [detailReady, setDetailReady] = useState(false);
+    const [detailError, setDetailError] = useState(false);
+    // 仅待开始、进行中且仅管理员可操作
+    const disabled = !(isAdmin && OPERABLE_STATUS.includes(record?.status));
+    const tooltip = isAdmin ? `${statusMap[record?.status]}的续班计划不支持该操作` : '仅续班计划管理员可操作';
+    // 本地唯一一份已选数据，标签区和表格勾选态都由它派生
+    const [selected, setSelected] = useState([]);
+
+    const renewalNumber = record?.number;
+
+    const {loading: detailLoading} = useRequest(() => getPureRenewRelations({renewMasterNumber: renewalNumber}), {
+        ready: open,
+        onSuccess(res) {
+            const {code, data} = res || {};
+            if (code === 0) {
+                const list = data || [];
+                setSelected(list);
+                setDetailReady(true);
+                setDetailError(false);
+                return;
+            }
+            setDetailReady(true);
+            setDetailError(true);
+            // code !== 0 时全局拦截器已弹 notification.error，不重复提示
+        },
+        onError() {
+            setDetailReady(true);
+            setDetailError(true);
+            message.error('关联数据加载失败，请重试');
+        },
+    });
+
+    const {run: runSave, loading: saving} = useRequest(savePureRenewRelations, {
+        manual: true,
+        onSuccess(res) {
+            if (res?.code === 0) {
+                message.success('保存成功');
+                setOpen(false);
+            }
+            // code !== 0 时全局拦截器已弹 notification.error，不重复提示
+        },
+        onError() {
+            message.error('保存失败，请重试');
+        },
+    });
+
+    const selectedKeys = selected.map(i => i.number);
+
+    const handleOpen = useMemoizedFn(() => {
+        setSelected([]);
+        setDetailReady(false);
+        setDetailError(false);
+        setOpen(true);
+    });
+    const handleClose = useMemoizedFn(() => setOpen(false));
+
+    // 默认查待开始、进行中，清空状态后仍保持这个可关联范围
+    const handleBefore = useMemoizedFn(params => {
+        const next = {
+            ...params,
+            statusList: params.statusList?.length ? params.statusList : OPERABLE_STATUS,
+        };
+        next.name = next.name?.trim();
+        next.number = next.number?.trim();
+        return next;
+    });
+
+    const handleSelect = useMemoizedFn((row, checked) => {
+        setSelected(prev => (checked ? [...prev, row] : prev.filter(i => i.number !== row.number)));
+    });
+
+    const handleRemove = useMemoizedFn(number => setSelected(prev => prev.filter(i => i.number !== number)));
+
+    const handleOk = useMemoizedFn(() => {
+        if (!detailReady || detailLoading || detailError || saving) {
+            return;
+        }
+        const doSave = () =>
+            runSave({
+                mainRenewMasterNumber: renewalNumber,
+                subRenewMasterNumbers: selectedKeys,
+            });
+        Modal.confirm({
+            title: '确认保存绑定关系？',
+            content: selected.length > 0
+                ? (
+                    <div>
+                        <div>最终绑定以下续班计划：</div>
+                        {selected.map(item => (
+                            <div key={item.number}>
+                                {item.name || '--'}
+                            </div>
+                        ))}
+                    </div>
+                )
+                : '最终不绑定任何续班计划。',
+            onOk: doSave,
+        });
+    });
+
+    const rowSelection = {
+        type: 'checkbox',
+        hideSelectAll: true,
+        selectedRowKeys: selectedKeys,
+        onSelect: handleSelect,
+        // 自关联、关联上限均由后端保存时校验
+    };
+
+    return (
+        <>
+            <Tooltip title={disabled ? tooltip : ''}>
+                <span>
+                    <Access.Href disabled={disabled} onClick={handleOpen}>
+                        纯续关联
+                    </Access.Href>
+                </span>
+            </Tooltip>
+            {open && (
+                <Drawer
+                    open
+                    width={720}
+                    title="纯续关联"
+                    styles={{body: {display: 'flex', flexDirection: 'column', overflow: 'hidden'}}}
+                    onClose={handleClose}
+                    footer={(
+                        <div className={styles.footer}>
+                            {/* eslint-disable-next-line react/forbid-component-props */}
+                            <Button onClick={handleClose} className={styles.cancelBtn}>
+                                取消
+                            </Button>
+                            <Button
+                                type="primary"
+                                onClick={handleOk}
+                                loading={saving}
+                                disabled={!detailReady || detailLoading || detailError}
+                            >
+                                确定
+                            </Button>
+                        </div>
+                    )}
+                >
+                    <div className={styles.sectionTitle}>当前续班计划</div>
+                    <div className={styles.currentPlan}>
+                        <PlanInfo item={record} />
+                    </div>
+
+                    <div className={styles.sectionTitle}>
+                        {`已关联续班计划 (${selected.length})`}
+                    </div>
+                    <div className={styles.tags}>
+                        {selected.length === 0 && !detailLoading && !detailError && (
+                            <span className={styles.empty}>暂无关联</span>
+                        )}
+                        {detailError && <span className={styles.empty}>关联加载失败，请关闭后重试</span>}
+                        {selected.map(i => (
+                            <SelectedTag key={i.number} item={i} onRemove={handleRemove} />
+                        ))}
+                    </div>
+
+                    <div className={styles.sectionTitle}>搜索续班计划</div>
+                    <FeituData
+                        fetch="/product-b/b/renewMaster/list"
+                        dataPath="renewalMasterDTOList"
+                        onBefore={handleBefore}
+                    >
+                        <QueryFilter isKeyPressSubmit defaultCollapsed={false} span={8} labelWidth="auto">
+                            <ProFormText
+                                label="计划名称"
+                                name="name"
+                                fieldProps={{placeholder: '请输入计划名称', maxLength: 100}}
+                            />
+                            <ProFormText
+                                label="计划ID"
+                                name="number"
+                                fieldProps={{placeholder: '请输入计划ID'}}
+                            />
+                            <ProFormSelect
+                                label="状态"
+                                name="statusList"
+                                fieldProps={{
+                                    mode: 'multiple',
+                                    placeholder: '请选择状态',
+                                    options: OPERABLE_STATUS_OPTIONS,
+                                    maxTagCount: 2,
+                                }}
+                                initialValue={OPERABLE_STATUS_VALUES}
+                                showAllow
+                            />
+                            <ProFormSelect
+                                label="过滤测试数据"
+                                name="filterTestData"
+                                fieldProps={{
+                                    placeholder: '请选择状态',
+                                    options: IS_TEST_DATA_OPTIONS,
+                                }}
+                                initialValue={1}
+                            />
+                        </QueryFilter>
+                        <FeituTable
+                            columns={columns}
+                            rowSelection={rowSelection}
+                            rowKey="number"
+                            scroll={{y: 'calc(100vh - 540px)'}}
+                        />
+                    </FeituData>
+                </Drawer>
+            )}
+        </>
+    );
+}
+
+PureRenewRelation.propTypes = {
+    record: planPropType.isRequired,
+    isAdmin: PropTypes.bool,
+};
+
+PureRenewRelation.defaultProps = {
+    isAdmin: false,
+};
+
+export default memo(PureRenewRelation);
