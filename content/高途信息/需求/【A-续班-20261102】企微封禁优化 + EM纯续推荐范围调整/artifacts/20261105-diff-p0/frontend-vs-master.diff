+import {renewalPlanStatusEnum} from '../src/pages/continuationClasses/config';
+
+const {WAIT_START, IN_PROGRESS, FINISHED} = renewalPlanStatusEnum;
+
+// 已关联的从计划（回显用）
+const RELATED_LIST = [
+    {number: '587948923239491585', name: '2026秋季续班计划-数学小班', status: IN_PROGRESS, adminName: '李四'},
+    {number: '587948923239491586', name: '2026秋季续班计划-英语大班', status: WAIT_START, adminName: '王五'},
+];
+
+// 搜索可选计划（复用 renewMaster/list，这里加几条供筛选）
+const SEARCH_EXTRA = [
+    {
+        number: '587948923239491587', name: '2026秋季续班计划-物理大班', status: IN_PROGRESS, adminName: '赵六',
+        adminList: [{id: '227658129872', name: '赵六'}]
+    },
+    {
+        number: '587948923239491588', name: '2026秋季续班计划-化学小班', status: WAIT_START, adminName: '钱七',
+        adminList: [{id: 30004, name: '钱七'}]
+    },
+    {
+        number: '587948923239491589', name: '2026秋季续班计划-语文大班', status: IN_PROGRESS, adminName: '孙八',
+        adminList: [{id: 30005, name: '孙八'}]
+    },
+    {
+        number: '587948923239491590', name: '2026春季续班计划-数学大班', status: FINISHED, adminName: '周九',
+        adminList: [{id: 30006, name: '周九'}]
+    },
+    {
+        number: '587948923239491591', name: '2026春季续班计划-英语小班', status: IN_PROGRESS, adminName: '吴十',
+        adminList: [{id: 30007, name: '吴十'}]
+    },
+];
+
+export default {
+    // 查询已关联从计划
+    'GET /product-b/b/renewMaster/relation/list': (req, res) => {
+        // 与后端一致：不返回自身（不可自关联）
+        const self = String(req.query?.renewMasterNumber || '');
+        res.json({code: 0, msg: 'success', data: RELATED_LIST.filter(i => i.number !== self)});
+    },
+
+    // 保存关联（全量覆盖，直接返回成功）
+    'POST /product-b/b/renewMaster/relation/save': (req, res) => {
+        res.json({code: 0, msg: 'success', data: null});
+    },
+
+    // 搜索续班计划（在现有 list mock 里追加几条，这里单独覆盖用于演示纯续关联场景）
+    'POST /product-b/b/renewMaster/list': (req, res) => {
+        const {name, statusList} = req.body || {};
+        const all = [
+            ...RELATED_LIST.map(i => ({...i, adminList: [{id: 0, name: i.adminName}]})),
+            ...SEARCH_EXTRA,
+        ];
+        // 与后端一致：按 statusList 过滤（纯续搜索固定传待开始、进行中）
+        const filtered = all
+            .filter(i => !name || i.name.includes(name))
+            .filter(i => !statusList?.length || statusList.includes(i.status));
+        res.json({
+            code: 0,
+            msg: 'success',
+            data: {
+                renewalMasterDTOList: filtered,
+                total: filtered.length,
+                pageNum: 1,
+                pageSize: 10,
+            },
+        });
+    },
+};
diff --git a/src/pages/continuationClasses/components/PureRenewRelation/index.js b/src/pages/continuationClasses/components/PureRenewRelation/index.js
