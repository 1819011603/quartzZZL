+     * 返回两侧原始响应人工比对。网关侧模型 / 自定义参数取自应用级覆盖。任一侧失败返回 event=ERROR 的响应。
+     *
+     * @param aiApplicationName AI应用名称
+     * @param userQuery         用户查询内容
+     * @param userTag           用户标签（可选，默认 test）
+     * @param context           上下文信息（可选）
+     * @return key 为 dify / gateway 的原始响应
+     */
+    public Map<String, DifyResponse> compareAiApplication(String aiApplicationName, String userQuery,
+        String userTag, Object context) {
+        validateTestParameters(aiApplicationName, userQuery);
+        Map<String, DifyResponse> result = new LinkedHashMap<>(4);
+        result.put("dify", runWithPlatform(aiApplicationName, userQuery, userTag, context, 1));
+        result.put("gateway", runWithPlatform(aiApplicationName, userQuery, userTag, context, 2));
+        return result;
+    }
+
+    /**
+     * 以指定平台跑一次
+     */
+    private DifyResponse runWithPlatform(String aiApplicationName, String userQuery, String userTag,
+        Object context, Integer platformType) {
+        String finalUserTag = StringUtils.isNotBlank(userTag) ? userTag : "test";
+        SyncRequestTaskCommand command = createSyncRequestTaskCommandByName(aiApplicationName, userQuery, finalUserTag);
+        command.setPlatformType(platformType);
+        try {
+            return aiApplicationExecutor.syncRequestTask(generateEntryKey(), command, context, "");
+        } catch (Exception e) {
+            log.error("compareAiApplication | platformType: {} 失败, 应用名称: {}", platformType, aiApplicationName, e);
+            DifyResponse error = new DifyResponse();
+            error.setEvent("ERROR");
+            error.setMessage(e.getMessage());
+            return error;
+        }
+    }
