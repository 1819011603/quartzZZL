@@ -0,0 +1,49 @@
+package com.gaotu.student.data.domain.ai.core.agentaccess;
+
+import java.util.Collections;
+import java.util.Map;
+
+import org.springframework.stereotype.Component;
+
+import com.ctrip.framework.apollo.spring.annotation.ApolloJsonValue;
+
+import lombok.extern.slf4j.Slf4j;
+
+/**
+ * AI 应用访问覆盖解析器
+ * <p>
+ * 读 Apollo `ai.agent.accessor.override.map`（key 为 ai_agent.number 字符串），按应用粒度返回覆盖配置，
+ * 让续班/退费 Dify 应用在运行时改走 LLM 网关（并可指定模型、输出格式），可单独切、可单独回滚，
+ * 不需要改 ai_agent.platform_type。未配置的应用返回 null，调用方按原逻辑取值。
+ *
+ * @author masheng
+ * @date 2026/10/27 17:50
+ */
+@Slf4j
+@Component
+public class AiAgentAccessorOverrideResolver {
+
+    /**
+     * key 为 ai_agent.number（字符串），value 为覆盖配置
+     */
+    @ApolloJsonValue("${ai.agent.accessor.override.map:{}}")
+    private Map<String, AiAgentAccessorOverride> overrideMap = Collections.emptyMap();
+
+    /**
+     * 解析指定应用的覆盖配置
+     *
+     * @param aiAgentNumber ai_agent.number
+     * @return 覆盖配置，未配置或为空时返回 null
+     */
+    public AiAgentAccessorOverride resolve(Long aiAgentNumber) {
+        if (aiAgentNumber == null || overrideMap.isEmpty()) {
+            return null;
+        }
+        AiAgentAccessorOverride override = overrideMap.get(String.valueOf(aiAgentNumber));
+        if (override != null) {
+            log.info("AiAgentAccessorOverrideResolver | resolve | aiAgentNumber: {}, override: {}",
+                aiAgentNumber, override);
+        }
+        return override;
+    }
+}
