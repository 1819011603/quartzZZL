+package com.gaotu.student.data.domain.ai.core.agentaccess;
+
+import java.util.Map;
+
+import lombok.Data;
+
+/**
+ * AI 应用访问覆盖配置（按 ai_agent 粒度）
+ * <p>
+ * 续班/退费 Dify 下线用：运行时给指定应用改走 LLM 网关，并可按应用追加自定义请求参数。
+ * 各字段为空时用原值（platform_type 用库值、model 用调用方传入、params 不追加）。
+ *
+ * @author masheng
+ * @date 2026/10/27 17:50
+ */
+@Data
+public class AiAgentAccessorOverride {
+
+    /**
+     * 应用名称（仅可读性用，便于从 Apollo 一眼看出这个 ID 是什么应用），不参与逻辑
+     */
+    private String name;
+
+    /**
+     * 目标 platform_type，如 2（LLM 网关）；为空取 ai_agent.platform_type
+     */
+    private Integer platformType;
+
+    /**
+     * 目标模型 modelCode；为空用调用方 command 里的 modelName
+     */
+    private String model;
+
+    /**
+     * 追加到网关请求体的自定义参数（OpenAI 兼容），如 {"response_format":{"type":"json_object"},"temperature":0.2}；
+     * 其中 model / max_tokens / messages 由代码控制，params 里的同名键不生效
+     */
+    private Map<String, Object> params;
+}
