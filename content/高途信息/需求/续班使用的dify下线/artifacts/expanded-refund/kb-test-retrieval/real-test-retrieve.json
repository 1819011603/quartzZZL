    "query": {
        "content": "\u9000\u8d39\u76f4\u63a5\u539f\u56e0:\u5bb6\u957f\u8ba4\u4e3a\u7b54\u7591\u53cd\u9988\u6162\uff0c\u5b69\u5b50\u8bfe\u540e\u4e0d\u4f1a\u505a\uff0c\u6b63\u5728\u72b9\u8c6b\u662f\u5426\u9000\u8d39 \u9000\u8d39\u539f\u56e0\u5206\u7c7b:\u670d\u52a1\u4e0d\u6ee1\u610f-\u6c9f\u901a\u7b54\u7591\u53ca\u65f6\u6027"
    },
    "records": [
        {
            "segment": {
                "id": "fad85dc9-fea3-45c5-9721-35b6179113cb",
                "position": 29,
                "document_id": "9e160ead-c8d2-4c7d-91fa-95cc3a9f311c",
                "content": "\u5e8f\u53f7: 12;\u4e00\u7ea7\u5206\u7c7b: \u4e8c\u8bb2\u95ee\u9898;\u4e8c\u6781\u5206\u7c7b: \u670d\u52a1\u4e0d\u6ee1\u610f-\u6c9f\u901a\u7b54\u7591\u53ca\u65f6\u6027;\u5efa\u8bae\u8bdd\u672f: \uff081\uff09\u8bdd\u672f\u903b\u8f91\n1.\u627f\u8ba4\u9519\u8bef\uff0c\u5b89\u629a\u60c5\u7eea\uff0c\u653e\u4e0b\u4e0e\u5bb6\u957f\u7684\u5bf9\u7acb\u60c5\u7eea\uff0c\u8ba9\u5bf9\u65b9\u611f\u53d7\u5230\u4f60\u61c2\u6211\u7684\u4e0d\u6ee1\uff0c\u800c\u4e0d\u662f\u5355\u7eaf\u7684\u88ab\u201c\u89e3\u91ca\u201d\n2.\u660e\u786e\u95ee\u9898\uff0c\u4e86\u89e3\u7b54\u7591\u6216\u8005\u56de\u590d\u4e0d\u53ca\u65f6\u7684\u5177\u4f53\u95ee\u9898\u6240\u5728\u907f\u514d\u4fe1\u606f\u6a21\u7cca\u5bfc\u81f4\u89e3\u51b3\u4e0d\u5230\u4f4d\n3.\u7ed9\u51fa\u89e3\u51b3\u65b9\u6848\uff0c\u4ee5\u53ca\u540e\u671f\u4fdd\u969c\uff08\u53ca\u65f6\u8865\u6551+\u957f\u671f\u673a\u5236\uff0c\u91cd\u5efa\u4fe1\u4efb\u611f\uff09\n\u6838\u5fc3\uff1a\u5c11\u8c08\u9000\u8d39\uff08\u4e0d\u5bf9\u6297\u8d1f\u9762\u60c5\u7eea\uff09\uff0c\u591a\u8c08\u95ee\u9898\u89e3\u51b3\uff08\u884c\u52a8\uff09\u901a\u8fc7 \u201c\u5b69\u5b50\u7684\u5229\u76ca + \u95ee\u9898\u7684\u89e3\u51b3 + \u72ec\u7279\u7684\u4ef7\u503c\u201d\uff0c\u7ed9\u5bb6\u957f\u4e00\u4e2a \u201c\u7559\u4e0b\u66f4\u5212\u7b97\u201d \u7684\u7406\u7531\n\uff082\uff09\u5177\u4f53\u8bdd\u672f\n1.\u627f\u8ba4\u8d23\u4efb+\u5171\u60c5\n\u201cXX \u5bb6\u957f\uff0c\u7279\u522b\u7406\u89e3\u60a8\u73b0\u5728\u60f3\u9000\u8d39\u7684\u51b3\u5b9a \u2014\u2014 \u4e4b\u524d\u6c9f\u901a\u4e0d\u53ca\u65f6\u786e\u5b9e\u8ba9\u60a8\u53d7\u4e86\u59d4\u5c48\uff0c\u751a\u81f3\u53ef\u80fd\u5f71\u54cd\u4e86\u60a8\u5bf9\u5b69\u5b50\u5b66\u4e60\u7684\u4fe1\u5fc3\uff0c\u6362\u4f5c\u662f\u6211\uff0c\u53ef\u80fd\u4e5f\u4f1a\u89c9\u5f97\u2018\u4e0d\u5982\u7b97\u4e86\u2019\u60a8\u80fd\u76f4\u63a5\u8bf4\u51fa\u60f3\u6cd5\uff0c\u53cd\u800c\u8ba9\u6211\u4eec\u66f4\u6e05\u695a\u95ee\u9898\u6709\u591a\u4e25\u91cd\uff0c\u8fd9\u70b9\u7279\u522b\u611f\u8c22\u60a8\u201d\n\u201c\u8bf4\u771f\u7684\uff0c\u542c\u5230\u60a8\u60f3\u9000\u8d39\uff0c\u6211\u4eec\u65e2\u6127\u759a\u53c8\u7740\u6025 \u2014\u2014",
                "sign_content": "\u5e8f\u53f7: 12;\u4e00\u7ea7\u5206\u7c7b: \u4e8c\u8bb2\u95ee\u9898;\u4e8c\u6781\u5206\u7c7b: \u670d\u52a1\u4e0d\u6ee1\u610f-\u6c9f\u901a\u7b54\u7591\u53ca\u65f6\u6027;\u5efa\u8bae\u8bdd\u672f: \uff081\uff09\u8bdd\u672f\u903b\u8f91\n1.\u627f\u8ba4\u9519\u8bef\uff0c\u5b89\u629a\u60c5\u7eea\uff0c\u653e\u4e0b\u4e0e\u5bb6\u957f\u7684\u5bf9\u7acb\u60c5\u7eea\uff0c\u8ba9\u5bf9\u65b9\u611f\u53d7\u5230\u4f60\u61c2\u6211\u7684\u4e0d\u6ee1\uff0c\u800c\u4e0d\u662f\u5355\u7eaf\u7684\u88ab\u201c\u89e3\u91ca\u201d\n2.\u660e\u786e\u95ee\u9898\uff0c\u4e86\u89e3\u7b54\u7591\u6216\u8005\u56de\u590d\u4e0d\u53ca\u65f6\u7684\u5177\u4f53\u95ee\u9898\u6240\u5728\u907f\u514d\u4fe1\u606f\u6a21\u7cca\u5bfc\u81f4\u89e3\u51b3\u4e0d\u5230\u4f4d\n3.\u7ed9\u51fa\u89e3\u51b3\u65b9\u6848\uff0c\u4ee5\u53ca\u540e\u671f\u4fdd\u969c\uff08\u53ca\u65f6\u8865\u6551+\u957f\u671f\u673a\u5236\uff0c\u91cd\u5efa\u4fe1\u4efb\u611f\uff09\n\u6838\u5fc3\uff1a\u5c11\u8c08\u9000\u8d39\uff08\u4e0d\u5bf9\u6297\u8d1f\u9762\u60c5\u7eea\uff09\uff0c\u591a\u8c08\u95ee\u9898\u89e3\u51b3\uff08\u884c\u52a8\uff09\u901a\u8fc7 \u201c\u5b69\u5b50\u7684\u5229\u76ca + \u95ee\u9898\u7684\u89e3\u51b3 + \u72ec\u7279\u7684\u4ef7\u503c\u201d\uff0c\u7ed9\u5bb6\u957f\u4e00\u4e2a \u201c\u7559\u4e0b\u66f4\u5212\u7b97\u201d \u7684\u7406\u7531\n\uff082\uff09\u5177\u4f53\u8bdd\u672f\n1.\u627f\u8ba4\u8d23\u4efb+\u5171\u60c5\n\u201cXX \u5bb6\u957f\uff0c\u7279\u522b\u7406\u89e3\u60a8\u73b0\u5728\u60f3\u9000\u8d39\u7684\u51b3\u5b9a \u2014\u2014 \u4e4b\u524d\u6c9f\u901a\u4e0d\u53ca\u65f6\u786e\u5b9e\u8ba9\u60a8\u53d7\u4e86\u59d4\u5c48\uff0c\u751a\u81f3\u53ef\u80fd\u5f71\u54cd\u4e86\u60a8\u5bf9\u5b69\u5b50\u5b66\u4e60\u7684\u4fe1\u5fc3\uff0c\u6362\u4f5c\u662f\u6211\uff0c\u53ef\u80fd\u4e5f\u4f1a\u89c9\u5f97\u2018\u4e0d\u5982\u7b97\u4e86\u2019\u60a8\u80fd\u76f4\u63a5\u8bf4\u51fa\u60f3\u6cd5\uff0c\u53cd\u800c\u8ba9\u6211\u4eec\u66f4\u6e05\u695a\u95ee\u9898\u6709\u591a\u4e25\u91cd\uff0c\u8fd9\u70b9\u7279\u522b\u611f\u8c22\u60a8\u201d\n\u201c\u8bf4\u771f\u7684\uff0c\u542c\u5230\u60a8\u60f3\u9000\u8d39\uff0c\u6211\u4eec\u65e2\u6127\u759a\u53c8\u7740\u6025 \u2014\u2014",
