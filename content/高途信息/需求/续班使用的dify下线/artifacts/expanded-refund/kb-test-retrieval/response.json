{"query":{"content":"\u9000\u8d39\u76f4\u63a5\u539f\u56e0:\u5bb6\u957f\u8ba4\u4e3a\u7b54\u7591\u53cd\u9988\u6162\uff0c\u5b69\u5b50\u8bfe\u540e\u4e0d\u4f1a\u505a\uff0c\u6b63\u5728\u72b9\u8c6b\u662f\u5426\u9000\u8d39 \u9000\u8d39\u539f\u56e0\u5206\u7c7b:\u670d\u52a1\u4e0d\u6ee1\u610f-\u6c9f\u901a\u7b54\u7591\u53ca\u65f6\u6027"},"records":[{"segment":{"id":"4cc185b0-098c-4c22-b886-7dba4b3c2fbe","position":19,"document_id":"cc41e00e-0410-4b69-a6df-674911a582b4","content":"\u5e8f\u53f7: 12;\u4e00\u7ea7\u5206\u7c7b: \u4e8c\u8bb2\u95ee\u9898;\u4e8c\u6781\u5206\u7c7b: \u670d\u52a1\u4e0d\u6ee1\u610f-\u6c9f\u901a\u7b54\u7591\u53ca\u65f6\u6027;\u5efa\u8bae\u8bdd\u672f: \uff081\uff09\u8bdd\u672f\u903b\u8f91\n1.\u627f\u8ba4\u9519\u8bef\uff0c\u5b89\u629a\u60c5\u7eea\uff0c\u653e\u4e0b\u4e0e\u5bb6\u957f\u7684\u5bf9\u7acb\u60c5\u7eea\uff0c\u8ba9\u5bf9\u65b9\u611f\u53d7\u5230\u4f60\u61c2\u6211\u7684\u4e0d\u6ee1\uff0c\u800c\u4e0d\u662f\u5355\u7eaf\u7684\u88ab\u201c\u89e3\u91ca\u201d\n2.\u660e\u786e\u95ee\u9898\uff0c\u4e86\u89e3\u7b54\u7591\u6216\u8005\u56de\u590d\u4e0d\u53ca\u65f6\u7684\u5177\u4f53\u95ee\u9898\u6240\u5728\u907f\u514d\u4fe1\u606f\u6a21\u7cca\u5bfc\u81f4\u89e3\u51b3\u4e0d\u5230\u4f4d\n3.\u7ed9\u51fa\u89e3\u51b3\u65b9\u6848\uff0c\u4ee5\u53ca\u540e\u671f\u4fdd\u969c\uff08\u53ca\u65f6\u8865\u6551+\u957f\u671f\u673a\u5236\uff0c\u91cd\u5efa\u4fe1\u4efb\u611f\uff09\n\u6838\u5fc3\uff1a\u5c11\u8c08\u9000\u8d39\uff08\u4e0d\u5bf9\u6297\u8d1f\u9762\u60c5\u7eea\uff09\uff0c\u591a\u8c08\u95ee\u9898\u89e3\u51b3\uff08\u884c\u52a8\uff09\u901a\u8fc7 \u201c\u5b69\u5b50\u7684\u5229\u76ca + \u95ee\u9898\u7684\u89e3\u51b3 + \u72ec\u7279\u7684\u4ef7\u503c\u201d\uff0c\u7ed9\u5bb6\u957f\u4e00\u4e2a \u201c\u7559\u4e0b\u66f4\u5212\u7b97\u201d \u7684\u7406\u7531\n\uff082\uff09\u5177\u4f53\u8bdd\u672f\n1.\u627f\u8ba4\u8d23\u4efb+\u5171\u60c5\n\u201cXX \u5bb6\u957f\uff0c\u7279\u522b\u7406\u89e3\u60a8\u73b0\u5728\u60f3\u9000\u8d39\u7684\u51b3\u5b9a \u2014\u2014 \u4e4b\u524d\u6c9f\u901a\u4e0d\u53ca\u65f6\u786e\u5b9e\u8ba9\u60a8\u53d7\u4e86\u59d4\u5c48\uff0c\u751a\u81f3\u53ef\u80fd\u5f71\u54cd\u4e86\u60a8\u5bf9\u5b69\u5b50\u5b66\u4e60\u7684\u4fe1\u5fc3\uff0c\u6362\u4f5c\u662f\u6211\uff0c\u53ef\u80fd\u4e5f\u4f1a\u89c9\u5f97\u2018\u4e0d\u5982\u7b97\u4e86\u2019\u60a8\u80fd\u76f4\u63a5\u8bf4\u51fa\u60f3\u6cd5\uff0c\u53cd\u800c\u8ba9\u6211\u4eec\u66f4\u6e05\u695a\u95ee\u9898\u6709\u591a\u4e25\u91cd\uff0c\u8fd9\u70b9\u7279\u522b\u611f\u8c22\u60a8\u201d\n\u201c\u8bf4\u771f\u7684\uff0c\u542c\u5230\u60a8\u60f3\u9000\u8d39\uff0c\u6211\u4eec\u65e2\u6127\u759a\u53c8\u7740\u6025 \u2014\u2014 \u6127\u759a\u7684\u662f\u6ca1\u505a\u597d\u670d\u52a1\uff0c\u8ba9\u60a8\u5931\u671b\u4e86\uff1b\u7740\u6025\u7684\u662f\uff0c\u5982\u679c\u5b69\u5b50\u56e0\u4e3a\u6211\u4eec\u7684\u5931\u8bef\u4e2d\u65ad\u5b66\u4e60\uff0c\u4e4b\u524d\u7684\u79ef\u7d2f\u53ef\u80fd\u65ad\u4e86\u8282\u594f\uff0c\u5bf9\u5b69\u5b50\u6765\u8bf4\u633a\u53ef\u60dc\u7684\u201d\n2.\u6df1\u6316\n\u60a8\u9009\u62e9\u9000\u8d39\uff0c\u9664\u4e86\u4e4b\u524d\u7684\u6c9f\u901a\u95ee\u9898\uff0c\u662f\u4e0d\u662f\u8fd8\u6709\u5176\u4ed6\u62c5\u5fc3\uff1f\u6bd4\u5982\uff1a\u62c5\u5fc3\u4e4b\u540e\u8fd8\u662f\u6ca1\u4eba\u53ca\u65f6\u56de\u590d\uff1f\u6216\u8005\u89c9\u5f97\u8bfe\u7a0b\u6548\u679c\u53d7\u5f71\u54cd\u4e86\uff1f\u60a8\u653e\u5fc3\u8bf4\uff0c\u6211\u4eec\u4e00\u5b9a\u5982\u5b9e\u56de\u5e94\u201d\uff08\u5bb6\u957f\u53ef\u80fd\u4f1a\u8865\u5145\uff1a\u201c\u6015\u4ee5\u540e\u8fd8\u662f\u8fd9\u6837\uff0c\u803d\u8bef\u5b69\u5b50\u201d\u201c\u611f\u89c9\u4f60\u4eec\u4e0d\u91cd\u89c6\u6211\u4eec\u201d \u7b49\uff0c\u6b64\u65f6\u9700\u9488\u5bf9\u6027\u56de\u5e94\uff09\n\uff08\u82e5\u5bb6\u957f\u63d0\u5230\u5b69\u5b50\uff09\u201c\u5176\u5b9e\u60a8\u6700\u5728\u610f\u7684\u8fd8\u662f\u5b69\u5b50\uff0c\u5bf9\u5427\uff1f\u6015\u6c9f\u901a\u4e0d\u53ca\u65f6\u5f71\u54cd\u4ed6\u7684\u5b66\u4e60\u8282\u594f\uff0c\u6bd4\u5982\u4f5c\u4e1a\u6ca1\u4eba\u6539\u3001\u7591\u95ee\u5806\u7740\u6ca1\u4eba\u7ba1\uff0c\u5bfc\u81f4\u4ed6\u8ddf\u4e0d\u4e0a\uff0c\u5bf9\u5417\uff1f\u201d\nPS\uff1a\u628a \u201c\u9000\u8d39\u201d \u4ece \u201c\u5bf9\u670d\u52a1\u7684\u4e0d\u6ee1\u201d \u8f6c\u5316\u4e3a \u201c\u5bf9\u5b69\u5b50\u5b66\u4e60\u7684\u62c5\u5fe7\u201d\uff0c\u4e3a\u540e\u7eed \u201c\u89e3\u51b3\u5b69\u5b50\u95ee\u9898\u201d \u94fa\u8def\n3.\u89e3\u51b3\u95ee\u9898\n\u201c\u4e3a\u4e86\u8ba9\u60a8\u653e\u5fc3\uff0c\u6211\u60f3\u4e86\u51e0\u4e2a\u5177\u4f53\u7684\u529e\u6cd5\uff1a\uff08\u5177\u4f53\u65b9\u6848\u7ed3\u5408\u5b9e\u9645\uff0c\u77ed\u671f\u5185\u6700\u597d\u7ed3\u5408\u81ea\u5df1\u65b9\u6848\u591a\u52a0\u5173\u6ce8\uff09\n\u2460\u6211\u7ed9\u60a8\u8bbe\u4e86\u2018\u6d88\u606f\u7f6e\u9876 + \u7279\u522b\u63d0\u9192\u2019\uff0c\u4ee5\u540e\u60a8\u7684\u4efb\u4f55\u6d88\u606f\uff0c\u62111 \u5c0f\u65f6\u5185\u5fc5\u56de\u2014\u2014 \u54ea\u6015\u5f53\u65f6\u5728\u4e0a\u8bfe \/ \u5f00\u4f1a\uff0c\u4e5f\u4f1a\u5148\u56de\u4e00\u53e5\u2018\u6536\u5230\uff0cXX \u70b9\u524d\u7ed9\u60a8\u8be6\u7ec6\u8bf4\u2019\uff0c\u7edd\u4e0d\u62d6\u5ef6\n\u2461\u6bcf\u5468\u8bfe\u7a0b\u7ed3\u675f\u4ee5\u540e\uff0c\u6211\u56fa\u5b9a\u7ed9\u60a8\u53d1\u4e00\u6761 XX \u7684\u5b66\u4e60\u5c0f\u7ed3\uff08\u6bd4\u5982\u2018\u672c\u5468\u638c\u63e1\u4e86 XX \u77e5\u8bc6\u70b9\uff0c\u6613\u9519\u70b9\u662f XX\uff0c\u5468\u672b\u53ef\u4ee5\u91cd\u70b9\u7ec3 XX\u2019\uff09\uff0c\u4e0d\u7528\u60a8\u50ac\uff0c\u6211\u4e3b\u52a8\u6c47\u62a5\uff0c\u8ba9\u60a8\u968f\u65f6\u77e5\u9053\u5b69\u5b50\u7684\u60c5\u51b5","sign_content":"\u5e8f\u53f7: 12;\u4e00\u7ea7\u5206\u7c7b: \u4e8c\u8bb2\u95ee\u9898;\u4e8c\u6781\u5206\u7c7b: \u670d\u52a1\u4e0d\u6ee1\u610f-\u6c9f\u901a\u7b54\u7591\u53ca\u65f6\u6027;\u5efa\u8bae\u8bdd\u672f: \uff081\uff09\u8bdd\u672f\u903b\u8f91\n1.\u627f\u8ba4\u9519\u8bef\uff0c\u5b89\u629a\u60c5\u7eea\uff0c\u653e\u4e0b\u4e0e\u5bb6\u957f\u7684\u5bf9\u7acb\u60c5\u7eea\uff0c\u8ba9\u5bf9\u65b9\u611f\u53d7\u5230\u4f60\u61c2\u6211\u7684\u4e0d\u6ee1\uff0c\u800c\u4e0d\u662f\u5355\u7eaf\u7684\u88ab\u201c\u89e3\u91ca\u201d\n2.\u660e\u786e\u95ee\u9898\uff0c\u4e86\u89e3\u7b54\u7591\u6216\u8005\u56de\u590d\u4e0d\u53ca\u65f6\u7684\u5177\u4f53\u95ee\u9898\u6240\u5728\u907f\u514d\u4fe1\u606f\u6a21\u7cca\u5bfc\u81f4\u89e3\u51b3\u4e0d\u5230\u4f4d\n3.\u7ed9\u51fa\u89e3\u51b3\u65b9\u6848\uff0c\u4ee5\u53ca\u540e\u671f\u4fdd\u969c\uff08\u53ca\u65f6\u8865\u6551+\u957f\u671f\u673a\u5236\uff0c\u91cd\u5efa\u4fe1\u4efb\u611f\uff09\n\u6838\u5fc3\uff1a\u5c11\u8c08\u9000\u8d39\uff08\u4e0d\u5bf9\u6297\u8d1f\u9762\u60c5\u7eea\uff09\uff0c\u591a\u8c08\u95ee\u9898\u89e3\u51b3\uff08\u884c\u52a8\uff09\u901a\u8fc7 \u201c\u5b69\u5b50\u7684\u5229\u76ca + \u95ee\u9898\u7684\u89e3\u51b3 + \u72ec\u7279\u7684\u4ef7\u503c\u201d\uff0c\u7ed9\u5bb6\u957f\u4e00\u4e2a \u201c\u7559\u4e0b\u66f4\u5212\u7b97\u201d \u7684\u7406\u7531\n\uff082\uff09\u5177\u4f53\u8bdd\u672f\n1.\u627f\u8ba4\u8d23\u4efb+\u5171\u60c5\n\u201cXX \u5bb6\u957f\uff0c\u7279\u522b\u7406\u89e3\u60a8\u73b0\u5728\u60f3\u9000\u8d39\u7684\u51b3\u5b9a \u2014\u2014 \u4e4b\u524d\u6c9f\u901a\u4e0d\u53ca\u65f6\u786e\u5b9e\u8ba9\u60a8\u53d7\u4e86\u59d4\u5c48\uff0c\u751a\u81f3\u53ef\u80fd\u5f71\u54cd\u4e86\u60a8\u5bf9\u5b69\u5b50\u5b66\u4e60\u7684\u4fe1\u5fc3\uff0c\u6362\u4f5c\u662f\u6211\uff0c\u53ef\u80fd\u4e5f\u4f1a\u89c9\u5f97\u2018\u4e0d\u5982\u7b97\u4e86\u2019\u60a8\u80fd\u76f4\u63a5\u8bf4\u51fa\u60f3\u6cd5\uff0c\u53cd\u800c\u8ba9\u6211\u4eec\u66f4\u6e05\u695a\u95ee\u9898\u6709\u591a\u4e25\u91cd\uff0c\u8fd9\u70b9\u7279\u522b\u611f\u8c22\u60a8\u201d\n\u201c\u8bf4\u771f\u7684\uff0c\u542c\u5230\u60a8\u60f3\u9000\u8d39\uff0c\u6211\u4eec\u65e2\u6127\u759a\u53c8\u7740\u6025 \u2014\u2014 \u6127\u759a\u7684\u662f\u6ca1\u505a\u597d\u670d\u52a1\uff0c\u8ba9\u60a8\u5931\u671b\u4e86\uff1b\u7740\u6025\u7684\u662f\uff0c\u5982\u679c\u5b69\u5b50\u56e0\u4e3a\u6211\u4eec\u7684\u5931\u8bef\u4e2d\u65ad\u5b66\u4e60\uff0c\u4e4b\u524d\u7684\u79ef\u7d2f\u53ef\u80fd\u65ad\u4e86\u8282\u594f\uff0c\u5bf9\u5b69\u5b50\u6765\u8bf4\u633a\u53ef\u60dc\u7684\u201d\n2.\u6df1\u6316\n\u60a8\u9009\u62e9\u9000\u8d39\uff0c\u9664\u4e86\u4e4b\u524d\u7684\u6c9f\u901a\u95ee\u9898\uff0c\u662f\u4e0d\u662f\u8fd8\u6709\u5176\u4ed6\u62c5\u5fc3\uff1f\u6bd4\u5982\uff1a\u62c5\u5fc3\u4e4b\u540e\u8fd8\u662f\u6ca1\u4eba\u53ca\u65f6\u56de\u590d\uff1f\u6216\u8005\u89c9\u5f97\u8bfe\u7a0b\u6548\u679c\u53d7\u5f71\u54cd\u4e86\uff1f\u60a8\u653e\u5fc3\u8bf4\uff0c\u6211\u4eec\u4e00\u5b9a\u5982\u5b9e\u56de\u5e94\u201d\uff08\u5bb6\u957f\u53ef\u80fd\u4f1a\u8865\u5145\uff1a\u201c\u6015\u4ee5\u540e\u8fd8\u662f\u8fd9\u6837\uff0c\u803d\u8bef\u5b69\u5b50\u201d\u201c\u611f\u89c9\u4f60\u4eec\u4e0d\u91cd\u89c6\u6211\u4eec\u201d \u7b49\uff0c\u6b64\u65f6\u9700\u9488\u5bf9\u6027\u56de\u5e94\uff09\n\uff08\u82e5\u5bb6\u957f\u63d0\u5230\u5b69\u5b50\uff09\u201c\u5176\u5b9e\u60a8\u6700\u5728\u610f\u7684\u8fd8\u662f\u5b69\u5b50\uff0c\u5bf9\u5427\uff1f\u6015\u6c9f\u901a\u4e0d\u53ca\u65f6\u5f71\u54cd\u4ed6\u7684\u5b66\u4e60\u8282\u594f\uff0c\u6bd4\u5982\u4f5c\u4e1a\u6ca1\u4eba\u6539\u3001\u7591\u95ee\u5806\u7740\u6ca1\u4eba\u7ba1\uff0c\u5bfc\u81f4\u4ed6\u8ddf\u4e0d\u4e0a\uff0c\u5bf9\u5417\uff1f\u201d\nPS\uff1a\u628a \u201c\u9000\u8d39\u201d \u4ece \u201c\u5bf9\u670d\u52a1\u7684\u4e0d\u6ee1\u201d \u8f6c\u5316\u4e3a \u201c\u5bf9\u5b69\u5b50\u5b66\u4e60\u7684\u62c5\u5fe7\u201d\uff0c\u4e3a\u540e\u7eed \u201c\u89e3\u51b3\u5b69\u5b50\u95ee\u9898\u201d \u94fa\u8def\n3.\u89e3\u51b3\u95ee\u9898\n\u201c\u4e3a\u4e86\u8ba9\u60a8\u653e\u5fc3\uff0c\u6211\u60f3\u4e86\u51e0\u4e2a\u5177\u4f53\u7684\u529e\u6cd5\uff1a\uff08\u5177\u4f53\u65b9\u6848\u7ed3\u5408\u5b9e\u9645\uff0c\u77ed\u671f\u5185\u6700\u597d\u7ed3\u5408\u81ea\u5df1\u65b9\u6848\u591a\u52a0\u5173\u6ce8\uff09\n\u2460\u6211\u7ed9\u60a8\u8bbe\u4e86\u2018\u6d88\u606f\u7f6e\u9876 + \u7279\u522b\u63d0\u9192\u2019\uff0c\u4ee5\u540e\u60a8\u7684\u4efb\u4f55\u6d88\u606f\uff0c\u62111 \u5c0f\u65f6\u5185\u5fc5\u56de\u2014\u2014 \u54ea\u6015\u5f53\u65f6\u5728\u4e0a\u8bfe \/ \u5f00\u4f1a\uff0c\u4e5f\u4f1a\u5148\u56de\u4e00\u53e5\u2018\u6536\u5230\uff0cXX \u70b9\u524d\u7ed9\u60a8\u8be6\u7ec6\u8bf4\u2019\uff0c\u7edd\u4e0d\u62d6\u5ef6\n\u2461\u6bcf\u5468\u8bfe\u7a0b\u7ed3\u675f\u4ee5\u540e\uff0c\u6211\u56fa\u5b9a\u7ed9\u60a8\u53d1\u4e00\u6761 XX \u7684\u5b66\u4e60\u5c0f\u7ed3\uff08\u6bd4\u5982\u2018\u672c\u5468\u638c\u63e1\u4e86 XX \u77e5\u8bc6\u70b9\uff0c\u6613\u9519\u70b9\u662f XX\uff0c\u5468\u672b\u53ef\u4ee5\u91cd\u70b9\u7ec3 XX\u2019\uff09\uff0c\u4e0d\u7528\u60a8\u50ac\uff0c\u6211\u4e3b\u52a8\u6c47\u62a5\uff0c\u8ba9\u60a8\u968f\u65f6\u77e5\u9053\u5b69\u5b50\u7684\u60c5\u51b5","answer":null,"word_count":914,"tokens":0,"keywords":["\u53ca\u65f6","\u6c9f\u901a","\u5bb6\u957f","\u95ee\u9898","\u8bdd\u672f","\u5b69\u5b50","\u5b66\u4e60","\u5177\u4f53","\u9000\u8d39","XX"],"index_node_id":"1afb2ca4-3131-4ddd-8c97-0820f958d2f4","index_node_hash":"6268f98796cb520b94b8d6c85326f0887e02cbf029c085af31542bcd2b7549c6","hit_count":0,"enabled":true,"disabled_at":null,"disabled_by":null,"status":"completed","created_by":"151350","created_at":1795456388,"indexing_at":1795456388,"completed_at":1795456391,"error":null,"stopped_at":null,"document":{"id":"cc41e00e-0410-4b69-a6df-674911a582b4","data_source_type":"upload_file","name":"source-copy.txt","doc_type":null,"doc_metadata":null}},"child_chunks":null,"score":null,"tsne_position":null},{"segment":{"id":"d4fdd71b-6236-4cb2-b5dc-1a43fc1847fd","position":68,"document_id":"cc41e00e-0410-4b69-a6df-674911a582b4","content":"\u5e8f\u53f7: 32;\u4e00\u7ea7\u5206\u7c7b: \u9009\u62e9\u5176\u4ed6\u8865\u4e60;\u4e8c\u6781\u5206\u7c7b: \u76d7\u7248\u8bfe&\u62fc\u8bfe;\u5efa\u8bae\u8bdd\u672f: \u4e00\u3001\u5171\u60c5\u5f00\u573a\uff1a\u7406\u89e3\u5bb6\u957f\u7684\u9009\u62e9\uff0c\u964d\u4f4e\u62b5\u89e6\u5fc3\u7406\n\u201cXX \u5988\u5988 \/ \u7238\u7238\uff0c\u7279\u522b\u7406\u89e3\u60a8\u7684\u60f3\u6cd5\uff01\u73b0\u5728\u5b69\u5b50\u5b66\u4e60\u6295\u5165\u786e\u5b9e\u4e0d\u5c0f\uff0c\u54b1\u4eec\u505a\u5bb6\u957f\u7684\u90fd\u60f3\u5728\u4fdd\u8bc1\u6548\u679c\u7684\u524d\u63d0\u4e0b\u8282\u7701\u5f00\u652f\uff0c\u80fd\u627e\u5230\u66f4\u5b9e\u60e0\u7684\u6e20\u9053\uff0c\u5176\u5b9e\u662f\u7279\u522b\u7528\u5fc3\u7684\u8868\u73b0\uff0c\u8fd9\u70b9\u6211\u7279\u522b\u8ba4\u540c\u3002\u201d\n\u4e8c\u3001\u5ba2\u89c2\u5206\u6790\u76d7\u7248\u8bfe\u7684\u9690\u6027\u98ce\u9669\uff1a\u4ece \u201c\u5f71\u54cd\u5b69\u5b50\u5b66\u4e60\u201d \u5207\u5165\uff0c\u800c\u975e\u5355\u7eaf\u6279\u5224\n\u201c\u4e0d\u8fc7\u6211\u63a5\u89e6\u8fc7\u4e0d\u5c11\u7c7b\u4f3c\u60c5\u51b5\u7684\u5bb6\u957f\uff0c\u540e\u6765\u5f88\u591a\u90fd\u53cd\u9988\u8bf4\uff0c\u76d7\u7248\u8bfe\u770b\u4f3c\u7701\u4e86\u94b1\uff0c\u4f46\u53ef\u80fd\u7ed9\u5b69\u5b50\u5b66\u4e60\u57cb\u4e86\u5751\uff1a\n\u9996\u5148\u662f\u5185\u5bb9\u5b8c\u6574\u6027\u548c\u65f6\u6548\u6027\uff1a\u9ad8\u4e2d\u8bfe\u7a0b\u6bcf\u5e74\u90fd\u6709\u5fae\u8c03\uff0c\u6bd4\u5982\u8003\u7eb2\u65b0\u589e\u7684\u77e5\u8bc6\u70b9\u3001\u9898\u578b\u53d8\u5316\uff08\u50cf\u6570\u5b66\u7684\u65b0\u60c5\u5883\u9898\u3001\u8bed\u6587\u7684\u65f6\u653f\u7ed3\u5408\u9898\uff09\uff0c\u6b63\u7248\u8bfe\u4f1a\u7b2c\u4e00\u65f6\u95f4\u66f4\u65b0\uff0c\u4f46\u76d7\u7248\u8bfe\u57fa\u672c\u662f\u7ffb\u5f55\u65e7\u5185\u5bb9\uff0c\u5b69\u5b50\u5b66\u7684\u53ef\u80fd\u662f\u2018\u8fc7\u65f6\u77e5\u8bc6\u2019\uff0c\u4e07\u4e00\u8003\u8bd5\u9047\u5230\u65b0\u8003\u70b9\uff0c\u5c31\u5bb9\u6613\u5403\u4e8f\u3002\n\u5176\u6b21\u662f\u5b66\u4e60\u6548\u679c\u6253\u6298\u6263\uff1a\u54b1\u4eec\u7684\u8bfe\u7a0b\u4e0d\u4ec5\u6709\u4e3b\u8bb2\u8001\u5e08\u7684\u65b9\u6cd5\u5927\u62db\u7684\u8bb2\u89e3\uff0c\u8fd8\u6709\u4e8c\u8bb2\u8001\u5e08\u7684\u8bfe\u540e1\u5bf91\u7b54\u7591\u548c\u5b66\u4e60\u89c4\u5212\uff0c\u914d\u5957\u7684\u8bfe\u540e\u7ec3\u4e60\u3001\u9636\u6bb5\u6027\u6d4b\u8bd5 \u2014\u2014 \u8fd9\u4e9b\u662f\u5b69\u5b50\u67e5\u6f0f\u8865\u7f3a\u7684\u5173\u952e\u3002\u4f46\u76d7\u7248\u8bfe\u5f80\u5f80\u53ea\u6709\u89c6\u9891\uff0c\u751a\u81f3\u753b\u9762\u6a21\u7cca\u3001\u58f0\u97f3\u4e0d\u6e05\uff0c\u5b69\u5b50\u5361\u58f3\u7684\u5730\u65b9\u6ca1\u4eba\u7b54\u7591\uff0c\u9519\u9898\u6ca1\u4eba\u5206\u6790\uff0c\u5176\u5b9e\u662f\u2018\u5b66\u4e86\u4f46\u6ca1\u5b8c\u5168\u5b66\u4f1a\u2019\uff0c\u53cd\u800c\u6d6a\u8d39\u4e86\u5b69\u5b50\u7684\u65f6\u95f4\uff08\u9ad8\u4e2d\u65f6\u95f4\u591a\u5b9d\u8d35\u554a\uff09\u3002\n\u6700\u540e\u662f\u9690\u6027\u6210\u672c\u66f4\u9ad8\uff1a\u4e4b\u524d\u6709\u4e2a\u5bb6\u957f\u7ed9\u5b69\u5b50\u7528\u76d7\u7248\u8bfe\uff0c\u5b69\u5b50\u5b66\u5230\u4e00\u534a\u53d1\u73b0\u5185\u5bb9\u7f3a\u4e86\u4e24\u7ae0\uff0c\u56de\u5934\u627e\u5356\u5bb6\u65e9\u5c31\u8054\u7cfb\u4e0d\u4e0a\u4e86\uff0c\u53ea\u80fd\u91cd\u65b0\u62a5\u8bfe\uff0c\u53cd\u800c\u591a\u82b1\u4e86\u94b1\uff0c\u5b69\u5b50\u8fd8\u803d\u8bef\u4e86\u8fdb\u5ea6\u3002\u8fd9\u79cd\u60c5\u51b5\u5176\u5b9e\u633a\u5e38\u89c1\u7684\u3002\u201d\n\u4e09\u3001\u7a81\u51fa\u6b63\u7248\u8bfe\u7684\u6838\u5fc3\u4ef7\u503c\uff1a\u8ba9\u5bb6\u957f\u89c9\u5f97 \u201c\u8d35\u6709\u8d35\u7684\u9053\u7406\uff0c\u7701\u94b1\u2260\u5212\u7b97\u201d\n\u201c\u5176\u5b9e\u54b1\u4eec\u5bb6\u957f\u7ed9\u5b69\u5b50\u62a5\u8bfe\uff0c\u6700\u7ec8\u8fd8\u662f\u770b\u2018\u80fd\u4e0d\u80fd\u5e2e\u5b69\u5b50\u63d0\u5206\u3001\u7701\u65f6\u95f4\u2019\u3002\u6b63\u7248\u8bfe\u4e4b\u6240\u4ee5\u6709\u8fd9\u4e2a\u4ef7\u683c\uff0c\u6838\u5fc3\u662f\u8fd9\u51e0\u70b9\u4e0d\u53ef\u66ff\u4ee3\uff1a\n\u5185\u5bb9\u5b9e\u65f6\u540c\u6b65\uff1a\u54b1\u4eec\u7684\u6559\u7814\u56e2\u961f\u6bcf\u6708\u90fd\u4f1a\u6839\u636e\u6700\u65b0\u8003\u7eb2\u8c03\u6574\u8bfe\u7a0b\uff0c\u6bd4\u5982\u4eca\u5e74\u65b0\u8bfe\u6807\u65b0\u589e\u7684\u2018\u903b\u8f91\u63a8\u7406\u2019\u9898\u578b\uff0c\u6211\u4eec\u4e0a\u5468\u521a\u52a0\u4e86 3 \u8282\u4e13\u9898\u8bfe\uff0c\u76d7\u7248\u80af\u5b9a\u8ddf\u4e0d\u4e0a\u3002\n\u914d\u5957\u670d\u52a1\u95ed\u73af\uff1a\u5b69\u5b50\u542c\u5b8c\u8bfe\uff0c\u4e8c\u8bb2\u8001\u5e08\u4f1a\u8ddf\u8fdb\u4f5c\u4e1a\u5b8c\u6210\u60c5\u51b5\uff0c\u9519\u9898\u4f1a\u4e13\u95e8\u8bb2\u89e3\uff1b\u6bcf\u5468\u8fd8\u6709\u76f4\u64ad\u7b54\u7591\uff0c\u5b69\u5b50\u54ea\u91cc\u4e0d\u61c2\u5f53\u573a\u95ee\uff0c\u76f8\u5f53\u4e8e\u2018\u628a\u8001\u5e08\u8bf7\u56de\u5bb6\u2019\uff0c\u8fd9\u662f\u76d7\u7248\u5b8c\u5168\u6ca1\u6709\u7684\u3002\n\u5b66\u4e60\u6548\u679c\u4fdd\u969c\uff1a\u6211\u4eec\u6709\u5b9a\u671f\u5b66\u60c5\u5206\u6790\uff0c\u80fd\u7cbe\u51c6\u5b9a\u4f4d\u5b69\u5b50\u7684\u8584\u5f31\u73af\u8282\uff08\u6bd4\u5982\u6709\u7684\u5b69\u5b50\u4e09\u89d2\u51fd\u6570\u516c\u5f0f\u603b\u8bb0\u9519\uff0c\u6211\u4eec\u4f1a\u63a8\u9001\u9488\u5bf9\u6027\u7ec3\u4e60\uff09\uff0c\u907f\u514d\u5b69\u5b50\u76f2\u76ee\u5237\u9898 \u2014\u2014 \u60a8\u770b\uff0c\u5b69\u5b50\u6548\u7387\u63d0\u4e0a\u6765\u4e86\uff0c\u5176\u5b9e\u662f\u5728\u2018\u7701\u65f6\u95f4\u6210\u672c\u2019\uff0c\u8fd9\u6bd4\u5355\u7eaf\u7701\u51e0\u767e\u5757\u66f4\u91cd\u8981\uff0c\u5bf9\u5417\uff1f\u201d","sign_content":"\u5e8f\u53f7: 32;\u4e00\u7ea7\u5206\u7c7b: \u9009\u62e9\u5176\u4ed6\u8865\u4e60;\u4e8c\u6781\u5206\u7c7b: \u76d7\u7248\u8bfe&\u62fc\u8bfe;\u5efa\u8bae\u8bdd\u672f: \u4e00\u3001\u5171\u60c5\u5f00\u573a\uff1a\u7406\u89e3\u5bb6\u957f\u7684\u9009\u62e9\uff0c\u964d\u4f4e\u62b5\u89e6\u5fc3\u7406\n\u201cXX \u5988\u5988 \/ \u7238\u7238\uff0c\u7279\u522b\u7406\u89e3\u60a8\u7684\u60f3\u6cd5\uff01\u73b0\u5728\u5b69\u5b50\u5b66\u4e60\u6295\u5165\u786e\u5b9e\u4e0d\u5c0f\uff0c\u54b1\u4eec\u505a\u5bb6\u957f\u7684\u90fd\u60f3\u5728\u4fdd\u8bc1\u6548\u679c\u7684\u524d\u63d0\u4e0b\u8282\u7701\u5f00\u652f\uff0c\u80fd\u627e\u5230\u66f4\u5b9e\u60e0\u7684\u6e20\u9053\uff0c\u5176\u5b9e\u662f\u7279\u522b\u7528\u5fc3\u7684\u8868\u73b0\uff0c\u8fd9\u70b9\u6211\u7279\u522b\u8ba4\u540c\u3002\u201d\n\u4e8c\u3001\u5ba2\u89c2\u5206\u6790\u76d7\u7248\u8bfe\u7684\u9690\u6027\u98ce\u9669\uff1a\u4ece \u201c\u5f71\u54cd\u5b69\u5b50\u5b66\u4e60\u201d \u5207\u5165\uff0c\u800c\u975e\u5355\u7eaf\u6279\u5224\n\u201c\u4e0d\u8fc7\u6211\u63a5\u89e6\u8fc7\u4e0d\u5c11\u7c7b\u4f3c\u60c5\u51b5\u7684\u5bb6\u957f\uff0c\u540e\u6765\u5f88\u591a\u90fd\u53cd\u9988\u8bf4\uff0c\u76d7\u7248\u8bfe\u770b\u4f3c\u7701\u4e86\u94b1\uff0c\u4f46\u53ef\u80fd\u7ed9\u5b69\u5b50\u5b66\u4e60\u57cb\u4e86\u5751\uff1a\n\u9996\u5148\u662f\u5185\u5bb9\u5b8c\u6574\u6027\u548c\u65f6\u6548\u6027\uff1a\u9ad8\u4e2d\u8bfe\u7a0b\u6bcf\u5e74\u90fd\u6709\u5fae\u8c03\uff0c\u6bd4\u5982\u8003\u7eb2\u65b0\u589e\u7684\u77e5\u8bc6\u70b9\u3001\u9898\u578b\u53d8\u5316\uff08\u50cf\u6570\u5b66\u7684\u65b0\u60c5\u5883\u9898\u3001\u8bed\u6587\u7684\u65f6\u653f\u7ed3\u5408\u9898\uff09\uff0c\u6b63\u7248\u8bfe\u4f1a\u7b2c\u4e00\u65f6\u95f4\u66f4\u65b0\uff0c\u4f46\u76d7\u7248\u8bfe\u57fa\u672c\u662f\u7ffb\u5f55\u65e7\u5185\u5bb9\uff0c\u5b69\u5b50\u5b66\u7684\u53ef\u80fd\u662f\u2018\u8fc7\u65f6\u77e5\u8bc6\u2019\uff0c\u4e07\u4e00\u8003\u8bd5\u9047\u5230\u65b0\u8003\u70b9\uff0c\u5c31\u5bb9\u6613\u5403\u4e8f\u3002\n\u5176\u6b21\u662f\u5b66\u4e60\u6548\u679c\u6253\u6298\u6263\uff1a\u54b1\u4eec\u7684\u8bfe\u7a0b\u4e0d\u4ec5\u6709\u4e3b\u8bb2\u8001\u5e08\u7684\u65b9\u6cd5\u5927\u62db\u7684\u8bb2\u89e3\uff0c\u8fd8\u6709\u4e8c\u8bb2\u8001\u5e08\u7684\u8bfe\u540e1\u5bf91\u7b54\u7591\u548c\u5b66\u4e60\u89c4\u5212\uff0c\u914d\u5957\u7684\u8bfe\u540e\u7ec3\u4e60\u3001\u9636\u6bb5\u6027\u6d4b\u8bd5 \u2014\u2014 \u8fd9\u4e9b\u662f\u5b69\u5b50\u67e5\u6f0f\u8865\u7f3a\u7684\u5173\u952e\u3002\u4f46\u76d7\u7248\u8bfe\u5f80\u5f80\u53ea\u6709\u89c6\u9891\uff0c\u751a\u81f3\u753b\u9762\u6a21\u7cca\u3001\u58f0\u97f3\u4e0d\u6e05\uff0c\u5b69\u5b50\u5361\u58f3\u7684\u5730\u65b9\u6ca1\u4eba\u7b54\u7591\uff0c\u9519\u9898\u6ca1\u4eba\u5206\u6790\uff0c\u5176\u5b9e\u662f\u2018\u5b66\u4e86\u4f46\u6ca1\u5b8c\u5168\u5b66\u4f1a\u2019\uff0c\u53cd\u800c\u6d6a\u8d39\u4e86\u5b69\u5b50\u7684\u65f6\u95f4\uff08\u9ad8\u4e2d\u65f6\u95f4\u591a\u5b9d\u8d35\u554a\uff09\u3002\n\u6700\u540e\u662f\u9690\u6027\u6210\u672c\u66f4\u9ad8\uff1a\u4e4b\u524d\u6709\u4e2a\u5bb6\u957f\u7ed9\u5b69\u5b50\u7528\u76d7\u7248\u8bfe\uff0c\u5b69\u5b50\u5b66\u5230\u4e00\u534a\u53d1\u73b0\u5185\u5bb9\u7f3a\u4e86\u4e24\u7ae0\uff0c\u56de\u5934\u627e\u5356\u5bb6\u65e9\u5c31\u8054\u7cfb\u4e0d\u4e0a\u4e86\uff0c\u53ea\u80fd\u91cd\u65b0\u62a5\u8bfe\uff0c\u53cd\u800c\u591a\u82b1\u4e86\u94b1\uff0c\u5b69\u5b50\u8fd8\u803d\u8bef\u4e86\u8fdb\u5ea6\u3002\u8fd9\u79cd\u60c5\u51b5\u5176\u5b9e\u633a\u5e38\u89c1\u7684\u3002\u201d\n\u4e09\u3001\u7a81\u51fa\u6b63\u7248\u8bfe\u7684\u6838\u5fc3\u4ef7\u503c\uff1a\u8ba9\u5bb6\u957f\u89c9\u5f97 \u201c\u8d35\u6709\u8d35\u7684\u9053\u7406\uff0c\u7701\u94b1\u2260\u5212\u7b97\u201d\n\u201c\u5176\u5b9e\u54b1\u4eec\u5bb6\u957f\u7ed9\u5b69\u5b50\u62a5\u8bfe\uff0c\u6700\u7ec8\u8fd8\u662f\u770b\u2018\u80fd\u4e0d\u80fd\u5e2e\u5b69\u5b50\u63d0\u5206\u3001\u7701\u65f6\u95f4\u2019\u3002\u6b63\u7248\u8bfe\u4e4b\u6240\u4ee5\u6709\u8fd9\u4e2a\u4ef7\u683c\uff0c\u6838\u5fc3\u662f\u8fd9\u51e0\u70b9\u4e0d\u53ef\u66ff\u4ee3\uff1a\n\u5185\u5bb9\u5b9e\u65f6\u540c\u6b65\uff1a\u54b1\u4eec\u7684\u6559\u7814\u56e2\u961f\u6bcf\u6708\u90fd\u4f1a\u6839\u636e\u6700\u65b0\u8003\u7eb2\u8c03\u6574\u8bfe\u7a0b\uff0c\u6bd4\u5982\u4eca\u5e74\u65b0\u8bfe\u6807\u65b0\u589e\u7684\u2018\u903b\u8f91\u63a8\u7406\u2019\u9898\u578b\uff0c\u6211\u4eec\u4e0a\u5468\u521a\u52a0\u4e86 3 \u8282\u4e13\u9898\u8bfe\uff0c\u76d7\u7248\u80af\u5b9a\u8ddf\u4e0d\u4e0a\u3002\n\u914d\u5957\u670d\u52a1\u95ed\u73af\uff1a\u5b69\u5b50\u542c\u5b8c\u8bfe\uff0c\u4e8c\u8bb2\u8001\u5e08\u4f1a\u8ddf\u8fdb\u4f5c\u4e1a\u5b8c\u6210\u60c5\u51b5\uff0c\u9519\u9898\u4f1a\u4e13\u95e8\u8bb2\u89e3\uff1b\u6bcf\u5468\u8fd8\u6709\u76f4\u64ad\u7b54\u7591\uff0c\u5b69\u5b50\u54ea\u91cc\u4e0d\u61c2\u5f53\u573a\u95ee\uff0c\u76f8\u5f53\u4e8e\u2018\u628a\u8001\u5e08\u8bf7\u56de\u5bb6\u2019\uff0c\u8fd9\u662f\u76d7\u7248\u5b8c\u5168\u6ca1\u6709\u7684\u3002\n\u5b66\u4e60\u6548\u679c\u4fdd\u969c\uff1a\u6211\u4eec\u6709\u5b9a\u671f\u5b66\u60c5\u5206\u6790\uff0c\u80fd\u7cbe\u51c6\u5b9a\u4f4d\u5b69\u5b50\u7684\u8584\u5f31\u73af\u8282\uff08\u6bd4\u5982\u6709\u7684\u5b69\u5b50\u4e09\u89d2\u51fd\u6570\u516c\u5f0f\u603b\u8bb0\u9519\uff0c\u6211\u4eec\u4f1a\u63a8\u9